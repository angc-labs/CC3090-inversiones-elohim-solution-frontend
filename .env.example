# API URL Configs
NEXT_PUBLIC_API_URL=http://localhost:5000
BACKEND_API_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Better Auth Configurations
BETTER_AUTH_SECRET=your_better_auth_secret_key_32_chars
BETTER_AUTH_URL=http://localhost:3000

# Database URL for Auth tables syncing
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dmhub

# Main Domain for Multi-tenant subdomains
NEXT_PUBLIC_MAIN_DOMAIN=dmhub.fun
